cat > .gitignore <<'EOF'
# --- Build outputs (Go backend) ---
webapi
cmd/webapi/webapi
*.exe
*.out

# --- Local DB / runtime files ---
*.db
*.sqlite
*.sqlite3

# --- Logs / temp ---
*.log
tmp/
.DS_Store

# --- IDE / editor ---
.vscode/
.idea/
*.iml

# --- Node / frontend ---
node_modules/
dist/
.yarn/
.pnp.*
.yarnrc.yml
package-lock.json
EOF
