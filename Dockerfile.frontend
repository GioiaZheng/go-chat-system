# Build stage: compile the Vue app with pinned Yarn tooling.
FROM node:18-alpine AS build

# Enable Corepack and activate Yarn 3.6.4 for reproducible installs.
RUN corepack enable && corepack prepare yarn@3.6.4 --activate

WORKDIR /app

# Copy lockfiles and Yarn configuration before installing dependencies (Berry requires this ordering).
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
COPY webui/.yarn/ .yarn/

# Install dependencies in immutable mode and build production assets.
RUN yarn install --immutable
COPY webui/ .
RUN yarn build

# Runtime stage: serve the built single-page app via NGINX.
FROM nginx:1.25-alpine

# Use the project-provided NGINX config to handle SPA routing.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy static assets into the default web root.
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
