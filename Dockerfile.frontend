# ===== Build stage =====
FROM node:20-alpine AS build
WORKDIR /app/webui

# 与老师环境一致：启用 Corepack + 固定 Yarn 3.2.1
RUN corepack enable && corepack prepare yarn@3.2.1 --activate

# 先拷依赖清单，最大化缓存
COPY webui/package*.json ./
# 如有 yarn.lock：也拷进去（没有则忽略）
# COPY webui/yarn.lock ./

# 安装依赖
RUN yarn install

# 拷源码并打包
COPY webui/ ./
RUN yarn build

# ===== Serve with Nginx =====
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/webui/dist/ /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
