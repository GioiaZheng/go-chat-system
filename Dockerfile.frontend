# Dockerfile.frontend（在仓库根目录）
FROM node:20-alpine AS build
WORKDIR /app/webui

# Yarn 3.2.1 + 禁用 PnP 所需文件
RUN corepack enable && corepack prepare yarn@3.2.1 --activate
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./

# 安装依赖（严格遵守 lock）
RUN yarn install --immutable

# 复制源码并构建
COPY webui/ ./
RUN yarn build

# 运行期：Nginx 托管静态文件
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/webui/dist/ /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
