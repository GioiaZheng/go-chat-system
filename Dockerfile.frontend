# ===== Build stage =====
FROM node:20-alpine AS build
WORKDIR /app/webui

# 先只拷贝 webui 的包清单，最大化缓存
COPY webui/package*.json ./
RUN npm ci

# 再拷贝 webui 源码并构建
COPY webui/ ./
RUN npm run build

# ===== Serve with Nginx =====
FROM nginx:alpine

# 单页应用路由配置（你已有 nginx.conf 就用这个）
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 拷贝打包产物
COPY --from=build /app/webui/dist/ /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
