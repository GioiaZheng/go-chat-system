# ===== Build stage =====
FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

# 复制源码并打包
COPY . .
RUN npm run build

# ===== Serve with Nginx =====
FROM nginx:alpine

# 若是单页应用（Vite/React Router），建议用下方 nginx.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 将打包产物放到默认站点
COPY --from=build /app/dist/ /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
