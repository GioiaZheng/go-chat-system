# ===== Build stage =====
FROM node:18-alpine AS build

# 1) Enable Corepack + Yarn 3.6.4
RUN corepack enable && corepack prepare yarn@3.6.4 --activate

WORKDIR /app

# 2) Copy lockfile + Yarn config + .yarn directory first (required for Berry)
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
COPY webui/.yarn/ .yarn/

# 3) Install dependencies (Berry expects --immutable)
RUN yarn install --immutable

# 4) Copy source and build
COPY webui/ .
RUN yarn build

# ===== Runtime stage =====
FROM nginx:1.25-alpine

# 5) nginx.conf lives at the repo root
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 6) Static assets
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
