FROM golang:1.17-alpine AS go-build
RUN apk add --no-cache build-base sqlite-dev
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG BUILD_TAGS=""
ENV CGO_ENABLED=1 GOOS=linux GOARCH=amd64
RUN go build -tags "$BUILD_TAGS" -ldflags "-s -w" -o /out/webapi ./cmd/webapi

FROM alpine:3.20
RUN apk add --no-cache sqlite-libs tzdata ca-certificates && adduser -D -H -s /sbin/nologin app
WORKDIR /app
COPY --from=go-build /out/webapi /app/webapi
RUN mkdir -p /data && chown -R app:app /data /app
USER app
ENV WASA_DB_FILENAME=/data/app.sqlite \
    GIN_MODE=release
EXPOSE 3000
ENTRYPOINT ["/app/webapi"]
