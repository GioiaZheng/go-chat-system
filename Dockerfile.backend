# Build with Go >= 1.19 (1.20 recommended)
FROM golang:1.20-alpine AS build
RUN apk add --no-cache build-base git sqlite-dev
ENV CGO_ENABLED=1 GOOS=linux GOARCH=amd64
WORKDIR /app

# 先拉依赖，最大化缓存
COPY go.mod go.sum ./
RUN go mod download

# 再拷源码并构建
COPY . .
RUN go build -ldflags="-s -w" -o /bin/wasatext ./cmd/webapi

# ---- Runtime ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata sqlite-libs && adduser -D -H -u 10001 appuser
WORKDIR /srv
COPY --from=build /bin/wasatext /usr/local/bin/wasatext

# 数据库落到可挂载目录
VOLUME ["/data"]
ENV PORT=3000 \
    DB_PATH=/data/wasatext.db \
    DB_DSN="file:/data/wasatext.db?_fk=1&cache=shared" \
    TZ=Europe/Rome

EXPOSE 3000
USER appuser

# 注意：health 路径请改成你服务实际的存活探针，比如 /liveness
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/liveness" || exit 1

ENTRYPOINT ["/usr/local/bin/wasatext"]
